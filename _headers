/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=()
  X-XSS-Protection: 1; mode=block
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: blob:; connect-src 'self' https://api.open-meteo.com https://*.tile.openstreetmap.org https://www.google-analytics.com https://www.googletagmanager.com; font-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/img/*
  Cache-Control: public, max-age=2592000

/*.css
  Cache-Control: public, max-age=604800

/*.js
  Cache-Control: public, max-age=604800

/service-worker.js
  Cache-Control: no-cache, must-revalidate

/favicon*
  Cache-Control: public, max-age=31536000, immutable

/android-chrome*
  Cache-Control: public, max-age=31536000, immutable

/apple-touch-icon*
  Cache-Control: public, max-age=31536000, immutable
